{
  "name": "subsweep",
  "version": "1.0.0",
  "private": true,
  "description": "SubSweep – Subscription Cleaner for YouTube: a Chrome and Firefox extension that finds YouTube channels you have outgrown and unsubscribes in bulk.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "node tools/test-browser.mjs",
    "lint": "node tools/check-syntax.mjs",
    "assets": "node tools/build-assets.mjs",
    "build": "node tools/build.mjs",
    "package": "node tools/package.mjs",
    "smoke": "node tools/smoke-test.mjs",
    "smoke:firefox": "node tools/smoke-test-firefox.mjs",
    "privacy": "node tools/build-privacy-page.mjs",
    "privacy:publish": "node tools/publish-privacy.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
