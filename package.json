{
  "name": "subsweep",
  "version": "1.0.0",
  "private": true,
  "description": "SubSweep – Subscription Cleaner for YouTube: a browser extension that finds YouTube channels you have outgrown and unsubscribes in bulk.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "lint": "node tools/check-syntax.mjs",
    "assets": "node tools/build-assets.mjs",
    "package": "node tools/package.mjs",
    "privacy": "node tools/build-privacy-page.mjs",
    "privacy:publish": "node tools/publish-privacy.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
